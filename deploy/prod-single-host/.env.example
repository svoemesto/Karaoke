BUILD_VERSION=1

# Heap karaoke-web: 3.8 ГБ RAM нового хоста (wayfinder #170).
# НЕ 8g (это admin/dev) и НЕ 1048m (старый прод) — 1200m с запасом.
APP_JAVA_OPTS=-Xmx1200m
# specs/288: TZ JVM = MSK для корреляции логов.
WEB_JAVA_OPTS=-Xmx1200m -Duser.timezone=Europe/Moscow

# Прод-сервер (для JDBC REMOTE-БД и мониторинга в karaoke-app).
PROD_HOST=188.127.240.124
PROD_PING_URL=https://sm-karaoke.ru/

# Контейнер karaoke-db
DB_FOLDER=/sm-karaoke/system/Караоке-db
DB_PORT_HOST=8832
DB_PORT_INSIDE_CONTAINER=5432
DB_LOCAL_POSTGRES_USER=postgres
DB_LOCAL_POSTGRES_PASSWORD=CHANGE_ME
DB_SERVER_POSTGRES_USER=CHANGE_ME
DB_SERVER_POSTGRES_PASSWORD=CHANGE_ME
DB_REMOTE_HOST=188.127.240.124
DB_REMOTE_PORT=5433

# Контейнер karaoke-web
WEB_PORT_HOST=8897
WEB_PORT_INSIDE_CONTAINER=7799

# Контейнер karaoke-webvue3 (не на прод-хосте; оставлено для совместимости)
WEBVUE3_PATH_TO_NGINX_CONF=/root/Karaoke/deploy/nginx_webvue3.conf

# Контейнер karaoke-public
PUBLIC_PATH_TO_NGINX_CONF=/root/Karaoke/deploy/nginx_karaoke-public.conf

# Контейнер karaoke-storage (loopback, #172)
STORAGE_FOLDER=/sm-karaoke/system/Караоке-storage
STORAGE_PORT_HOST=8890
STORAGE_PORT_INSIDE_CONTAINER=9000
STORAGE_CONSOLE_PORT_HOST=8891
STORAGE_CONSOLE_PORT_INSIDE_CONTAINER=9001
STORAGE_CONTAINER_NAME=karaoke-storage
STORAGE_KEY=CHANGE_ME
STORAGE_SECRET=CHANGE_ME

# Remote-store для karaoke-app (admin-машина) — куда заливаются картинки/аудио
# для публичного сайта. Порт 9000 — host-nginx `stream` (allow-list только admin
# 185.26.28.109) → loopback MinIO 127.0.0.1:8890. См. nginx.conf, Pass 445.
STORAGE_REMOTE_ENDPOINT=http://188.127.240.124:9000
