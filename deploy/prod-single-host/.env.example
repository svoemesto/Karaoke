BUILD_VERSION=1

# Heap karaoke-web: 3.8 ГБ RAM нового хоста (wayfinder #170).
# НЕ 8g (это admin/dev) и НЕ 1048m (старый прод) — 1200m с запасом.
APP_JAVA_OPTS=-Xmx1200m
# specs/288: TZ JVM = MSK для корреляции логов.
WEB_JAVA_OPTS=-Xmx1200m -Duser.timezone=Europe/Moscow

# Прод-сервер (для JDBC REMOTE-БД и мониторинга в karaoke-app).
PROD_HOST=188.127.240.124
PROD_PING_URL=https://sm-karaoke.ru/

# Контейнер karaoke-db
DB_FOLDER=/sm-karaoke/system/Караоке-db
DB_PORT_HOST=8832
DB_PORT_INSIDE_CONTAINER=5432
DB_LOCAL_POSTGRES_USER=postgres
DB_LOCAL_POSTGRES_PASSWORD=CHANGE_ME
DB_SERVER_POSTGRES_USER=CHANGE_ME
DB_SERVER_POSTGRES_PASSWORD=CHANGE_ME
DB_REMOTE_HOST=188.127.240.124
DB_REMOTE_PORT=5433

# BR-557 (аудит #336 / P-72-05, OpenProject #371): TLS до удалённой БД.
# Канал admin-машина → прод идёт через публичный интернет (L4 stream 5433
# в nginx.conf прод-хоста), а драйвер PostgreSQL при sslmode=prefer МОЛЧА
# деградирует в открытый текст: пароль БД и все прод-данные (tbl_site_users,
# tbl_subscriptions с yookassa_payment_id) видны в канале.
# Целевое состояние после включения TLS на сервере (DB_SSL_ON=on + сертификаты,
# см. deploy/prod-single-host/docker-compose-database.yml):
#   DB_REMOTE_SSL_MODE=verify-full   # TLS + проверка сертификата и имени хоста
#   DB_REMOTE_SSL_MODE=require       # TLS без проверки сертификата (хуже)
# Пока TLS на сервере не включён, значение prefer воспроизводит прежнее
# поведение (явно, а не «по умолчанию драйвера») — это принятый риск, решение
# «TLS на сервере vs SSH/WireGuard-туннель» за владельцем (#371).
DB_REMOTE_SSL_MODE=prefer

# BR-545: TLS на самом сервере Postgres прод-хоста. По умолчанию off — ровно
# дефолт PostgreSQL, поведение прода не меняется. Включение требует
# сертификатов в deploy/prod-single-host/certs/postgres/.
DB_SSL_ON=off

# Контейнер karaoke-web
WEB_PORT_HOST=8897
WEB_PORT_INSIDE_CONTAINER=7799

# Контейнер karaoke-webvue3 (не на прод-хосте; оставлено для совместимости)
WEBVUE3_PATH_TO_NGINX_CONF=/root/Karaoke/deploy/nginx_webvue3.conf

# Контейнер karaoke-public
PUBLIC_PATH_TO_NGINX_CONF=/root/Karaoke/deploy/nginx_karaoke-public.conf

# Контейнер karaoke-storage (loopback, #172)
STORAGE_FOLDER=/sm-karaoke/system/Караоке-storage
STORAGE_PORT_HOST=8890
STORAGE_PORT_INSIDE_CONTAINER=9000
STORAGE_CONSOLE_PORT_HOST=8891
STORAGE_CONSOLE_PORT_INSIDE_CONTAINER=9001
STORAGE_CONTAINER_NAME=karaoke-storage
STORAGE_KEY=CHANGE_ME
STORAGE_SECRET=CHANGE_ME

# Remote-store для karaoke-app (admin-машина) — куда заливаются картинки/аудио
# для публичного сайта. Порт 9000 — host-nginx `stream` (allow-list только admin:
# 185.26.28.109, 83.137.50.231, 185.26.28.199) → loopback MinIO 127.0.0.1:8890.
# См. nginx.conf, Pass 445.
#
# BR-557: сейчас канал http (L4 stream без TLS) — заголовок Authorization
# (SigV4-подпись) и тела объектов идут открытым текстом. Целевое состояние —
# TLS на MinIO (MINIO_CERTS_DIR на прод-хосте) и здесь:
#   STORAGE_REMOTE_ENDPOINT=https://188.127.240.124:9000
# до тех пор — либо принятый риск (зафиксировать), либо SSH-туннель.
STORAGE_REMOTE_ENDPOINT=http://188.127.240.124:9000
