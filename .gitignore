```
# Compiled and build artifacts
*.class
*.o
*.obj
*.out
build/
/.build/
target/
dist/

# Sensitive data
deploy/ollama_data/
deploy/whisper_models/

# Dependencies
.gradle/
node_modules/
venv/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*
# Шаблоны без секретов — трекаются (wayfinder #165).
!*.env.example
/deploy/.env
/deploy/do.env
/deploy/web-server-deploy/deploy/.env
/deploy/web-server-deploy/deploy/do.env
/deploy/new_comp/sm-karaoke-system/deploy/.env
/deploy/new_comp/sm-karaoke-system/deploy/do.env
# prod-single-host: реальные .env/do.env (секреты) игнорируем, шаблоны — трекаем.
/deploy/prod-single-host/.env
/deploy/prod-single-host/do.env

# registry: реальный htpasswd (bcrypt-креды проектов), спека 540 / issue #286.
# Шаблон htpasswd.example — трекаем. Проверка: git ls-files | grep -i htpasswd → пусто.
/deploy/prod-single-host/registry/htpasswd

# Tracker local integration secrets (Constitution § VIII, spec 295)
# Реальный файл .env.local-tracker содержит API-токены и пароли БД трекера.
.env.local-tracker

# Secrets — SSL-сертификаты и приватные ключи (Constitution Principle VIII.2)
*.key
*.pem
*.p12
*.pfx

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Generated API documentation (run ./tools/generate-docs.sh to rebuild)
docs/api/dokka/
docs/api/typedoc-*/

# Local tool indexes / config (per-machine, not part of repo)
.codegraph/
.opencode/
.dsh/
.docker/

# Cache files generated by `specify` CLI for the integration catalog
# (re-created on every `specify integration ...` invocation).
.specify/integrations/.cache/

# Playwright: артефакты прогонов e2e (BR-525, OpenProject #387)
playwright-report/
.artifacts/

# Per-machine speckit session state (specs/102-gitignore-feature-json) — указывает, какая фича
# сейчас активна НА ЭТОЙ машине/агенте; при параллельной работе нескольких машин/агентов над
# разными фичами коммит этого файла даёт merge-конфликт при каждом слиянии веток (см. PR #133/#134).
.specify/feature.json
```
# Локальные разовые артефакты (AGENTS.md, .scratch/karaoke/README.md)
.scratch/
.npm-cache/

# BR-046 (аудит #336, OpenProject #393): каталог дампов локальной БД монтируется в контейнер
# (deploy/docker-compose-database.yml: ./karaoke-db/dumps:/dumps). Дампы содержат персональные
# данные — в git им нельзя; каталог держим пустым (.gitkeep), чтобы docker не создавал его
# root-овым при первом restore_db.
/deploy/karaoke-db/dumps/*
!/deploy/karaoke-db/dumps/.gitkeep

# Осколки shell/python-редиректов в корне репозитория (имена стандартных модулей
# Python). Появляются при запуске инструментов с ошибочным перенаправлением
# (`2>file`, `>file`) и раньше случайно попадали в коммиты пакета PKG-S3-22
# (аудит #336, OpenProject #394): ~23 МБ каждый. Ignored-правила НЕ защищают от
# `git add -f` — за это отвечает guard tools/check-root-junk.sh.
/argparse
/collections
/os
/re
/subprocess
/sys

# Kotlin 2.x: локальный кэш сессий компиляции
.kotlin/
