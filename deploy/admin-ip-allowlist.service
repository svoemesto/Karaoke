[Unit]
Description=Karaoke: проверка allow-list прод-канала (расхождение → юнит в failed)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ExecStart указывает на УСТАНОВЛЕННЫЙ экземпляр скрипта, а не на файл в
# рабочем дереве: checkout может содержать незакоммиченные правки, и юнит
# не должен зависеть от его состояния. Установка на целевой машине (root) —
# по runbook knowledge/guidelines/runbooks/prod-tunnel.md § 3.8:
#   sudo install -m 755 deploy/admin-ip-allowlist.sh /usr/local/sbin/admin-ip-allowlist.sh
#   sudo cp deploy/admin-ip-allowlist.service /etc/systemd/system/admin-ip-allowlist.service
#   sudo systemctl daemon-reload
# Без установки юнита скрипт работает вручную:
#   bash deploy/admin-ip-allowlist.sh --diagnose
ExecStart=/usr/local/sbin/admin-ip-allowlist.sh
User=root
Group=root
# Токены Telegram и Forgejo — из файла с правами 600 (создаёт владелец):
#   /etc/admin-ip-allowlist.env
# В нём: ALLOWLIST_TELEGRAM_BOT_TOKEN, ALLOWLIST_TELEGRAM_CHAT_ID,
#        ALLOWLIST_FJ_TOKEN, ALLOWLIST_FJ_URL
#
# SSH-доступ к прод-хосту (прецедент 2026-11-02): сервис работает под root, у
# root нет ни ключа, ни known_hosts для прода — ssh падал с rc=255, механизм
# молча ничего не применял, и владелец узнавал об outage из интерфейса.
# Владелец задаёт в /etc/admin-ip-allowlist.env (root читает файлы пользователя):
#   ALLOWLIST_SSH_IDENTITY_FILE=/home/nsa/.ssh/id_rsa
#   ALLOWLIST_SSH_KNOWN_HOSTS=/home/nsa/.ssh/known_hosts
#   ALLOWLIST_SSH_STRICT_HOST_KEY=accept-new   # необязательно
# Проверка: bash deploy/admin-ip-allowlist.sh --check-ssh
# Прокси для вызова Telegram Bot API (необязательно, владелец):
#   ALLOWLIST_TELEGRAM_PROXY=socks5h://127.0.0.1:1080
# Применяется ТОЛЬКО к уведомлениям: определение внешнего адреса и пробы
# доступности идут напрямую (--noproxy '*').
EnvironmentFile=-/etc/admin-ip-allowlist.env
# Журнал: файл + journald (контракт journal-format.md).
Environment=ALLOWLIST_LOG_FILE=/var/log/admin-ip-allowlist.log
Environment=ALLOWLIST_STATE_FILE=/var/log/admin-ip-allowlist.state
# Режим туннеля (спека 733): публичный адрес админской машины в allow-list прод-хоста
# НЕ пишется никогда — только read-only проверка «ровно один адрес 10.77.0.1» и
# код выхода 3 (юнит уходит в failed — сигнал владельцу, runbook § 3.7).
# ВАЖНО: без этой переменной скрипт работает в public-режиме и ПЕРЕЗАПИСЫВАЕТ
# allow-list прод-хоста, заменяя туннельный адрес публичным IP — туннель
# отрезается, и приложение не может подключиться к серверной БД (прецедент
# 2026-11-12). Не удаляйте эту строку при обновлении юнита на хосте.
Environment=ALLOWLIST_MODE=tunnel
StandardOutput=journal
StandardError=journal
