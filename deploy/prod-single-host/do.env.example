## Секреты для скриптов деплоя. Копировать в do.env на хосте (НЕ в git).
## Взять реальные значения со старого прода (/root/Karaoke/deploy/do.env)
## или из ~/Karaoke/deploy/do.env на admin-машине.

DOCKER_REGISTRY=svoemestodev
DOCKER_PASSWORD=CHANGE_ME

YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME
STEMJOBS_INTERNAL_SECRET=CHANGE_ME
VK_CLIENT_SECRET=CHANGE_ME
VK_APP_ID=CHANGE_ME
VK_REDIRECT_URI=https://sm-karaoke.ru/api/public/utils/vkOAuthCallback
VK_ID_CLIENT_ID=CHANGE_ME
VK_ID_CLIENT_SECRET=CHANGE_ME
VK_ID_REDIRECT_URI=https://sm-karaoke.ru/api/public/utils/vkIdOAuthCallback
# admin-машина (не новый хост), без изменений:
VK_ID_ADMIN_API_URL=http://nsa-i9:8898
