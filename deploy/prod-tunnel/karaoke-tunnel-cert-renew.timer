# Ежедневная проверка срока клиентского сертификата mTLS (спека 733, FR-014).
# Продление само по себе идемпотентно: если до истечения больше 21 дня —
# сервис только пишет «продление не требуется» и завершается успешно.

[Unit]
Description=Ежедневная проверка срока клиентского сертификата mTLS (спека 733)

[Timer]
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
