# deploy/do.env.template
#
# Это ШАБЛОН env-файла для проекта Karaoke. Использование:
#   cp deploy/do.env.template deploy/do.env
#   chmod 600 deploy/do.env         # секреты — только для владельца
#   nano deploy/do.env              # заполните <SET-ME> и пути
#
# Затем:
#   cd deploy && bash do.sh start all        # поднять 7 контейнеров (без MinIO)
#   docker compose -f docker-compose-storage.yml up -d   # поднять MinIO
#
# ВАЖНО:
#   - deploy/do.env НЕ в гите (.gitignore: /deploy/do.env) — это секреты
#   - этот файл (do.env.template) КОММИТИТСЯ, но не должен содержать реальных секретов
#   - все <SET-ME> должны быть заменены перед первым запуском
#   - bash под `set -a; source` корректно пропускает # -комментарии (bash 5.2+)
#   - НЕ добавляйте секреты в этот файл — только в deploy/do.env!
#
# Принцип VIII Constitution: секреты НЕ в индексе git, НЕ в шаблонах.

# === СЕКРЕТЫ (ОБЯЗАТЕЛЬНО заполнить на новой машине) ===
# DOCKER_REGISTRY — обычно svoemesto (можно изменить на свой registry)
DOCKER_REGISTRY=svoemesto
# DOCKER_PASSWORD — нужен только для `do.sh push` (опционально на локалке)
DOCKER_PASSWORD="<SET-ME-OR-EMPTY>"
# STORAGE_KEY — MinIO access key (локально — любой непустой)
STORAGE_KEY="<SET-ME-MINIO-ACCESS-KEY-MIN-16-CHARS>"
# STORAGE_SECRET — MinIO secret key (локально — любой непустой)
STORAGE_SECRET="<SET-ME-MINIO-SECRET-KEY-MIN-32-CHARS>"
# DB_LOCAL_POSTGRES_USER — обычно postgres
DB_LOCAL_POSTGRES_USER=postgres
# DB_LOCAL_POSTGRES_PASSWORD — пароль локальной Postgres (ОБЯЗАТЕЛЬНО задать)
DB_LOCAL_POSTGRES_PASSWORD="<SET-ME-LOCAL-POSTGRES-PASSWORD>"
# DB_SERVER_* — используются в проде; на локалке можно оставить пустыми,
# но ПЕРЕМЕННЫЕ ДОЛЖНЫ БЫТЬ ЗАДАНЫ (do.sh читает их через `set -a; source`).
DB_SERVER_POSTGRES_USER="<SET-ME-OR-EMPTY>"
DB_SERVER_POSTGRES_PASSWORD="<SET-ME-OR-EMPTY>"
# DB_REMOTE_HOST — хост удалённой БД (для sync LOCAL↔SERVER); на локалке пусто
DB_REMOTE_HOST="<SET-ME-OR-EMPTY>"
# STEMJOBS_INTERNAL_SECRET — внутренний токен между app и web для stem-jobs
STEMJOBS_INTERNAL_SECRET="<SET-ME-STEMJOBS-SECRET>"

# === ПУТИ НА ХОСТЕ (ОБЯЗАТЕЛЬНО заполнить абсолютными путями) ===
# Бинд-маунты для karaoke-app (см. docker-compose.yml:27-30):
APP_FOLDER_HOST=/sm-karaoke/system/Караоке
APP_FOLDER_K1=/sm-karaoke/system/Караоке-1
APP_FOLDER_K2=/sm-karaoke/system/Караоке-2
APP_FOLDER_K3=/sm-karaoke/system/Караоке-3
APP_FOLDER_SYSTEM=/sm-karaoke/system
APP_FOLDER_STORE=/sm-karaoke/system/Караоке-store
# Путь внутри контейнера (обычно не меняется)
APP_FOLDER_IN_CONTAINER=/Караоке
# MinIO data directory
STORAGE_FOLDER=/sm-karaoke/system/Караоке-storage
# Postgres data directory
DB_FOLDER=/sm-karaoke/system/Караоке-db
# karaoke-web бинд-маунты (используются в docker-compose-web.yml, на локалке можно оставить дефолт)
WEB_FOLDER_HOST=/sm-karaoke/system/Караоке-web
WEB_FOLDER_IN_CONTAINER=/Караоке-web
# Пути к nginx-конфигам (для webvue3 и karaoke-public) — относительно deploy/
WEBVUE3_PATH_TO_NGINX_CONF=/sm-karaoke/system/Karaoke/webvue3/nginx.conf
WEBVUE_PATH_TO_NGINX_CONF=/sm-karaoke/system/Karaoke/karaoke-webvue/nginx.conf
PUBLIC_PATH_TO_NGINX_CONF=/sm-karaoke/system/Karaoke/karaoke-public/nginx.conf

# === ПОРТЫ (дефолты безопасные — оставить как есть) ===
# karaoke-app
APP_PORT_HOST=8900
APP_PORT_INSIDE_CONTAINER=8080
# karaoke-web
WEB_PORT_HOST=8090
WEB_PORT_INSIDE_CONTAINER=8090
# Postgres
DB_PORT_HOST=5432
DB_PORT_INSIDE_CONTAINER=5432
# MinIO S3 API
STORAGE_PORT_HOST=9000
STORAGE_PORT_INSIDE_CONTAINER=9000
# MinIO Console (web UI)
STORAGE_CONSOLE_PORT_HOST=9001
STORAGE_CONSOLE_PORT_INSIDE_CONTAINER=9001
# Stems-контейнеры (опционально)
STORAGE_CONTAINER_NAME=karaoke-storage

# === ПРОЧИЕ (дефолты OK, но переменные должны быть в файле) ===
# BUILD_VERSION — авто-вычисляется в do.sh:19-26 если пусто
# Оставьте пустым — do.sh прочитает deploy/.version
BUILD_VERSION=
# ENABLE_APP_GPU — 1 если есть nvidia passthrough, 0 если нет
# ВАЖНО: на dev-машинах без nvidia оставляйте 0 (см. AGENTS.md «Dockerfile-ловушки»)
ENABLE_APP_GPU=0
# JAVA_OPTS — пустая СТРОКА, не [].
# ВАЖНО: bash под `set -a; source` экспортирует переменные. Пустые кавычки
# обязательны — иначе java получит пустой аргумент перед -jar и упадёт
# "Could not find or load main class" (см. docker-compose.yml:51-56).
APP_JAVA_OPTS=""
WEB_JAVA_OPTS=""
# FORCE — 1 чтобы пересобрать образы даже при неизменном отпечатке (см. build-lock.sh)
# Используется ТОЛЬКО для разовой принудительной пересборки; оставьте пустым.
FORCE=
# WORK_ON_SERVER — флаг для karaoke-web: 0 = dev-режим (БД не LOCAL, а remote),
# 1 = прод-режим. На docker-compose-web.yml задано явно (=0); в основном
# docker-compose.yml WORK_ON_SERVER не задаётся — нужно прокинуть через .env.
# Если 0 и Spring не найдёт переменную — падает с 'Could not resolve placeholder'.
WORK_ON_SERVER=0
# WORK_IN_CONTAINER — НЕ задавайте здесь. Выставляется в compose-файлах как 1.
# DISPLAY — X11 display для GUI karaoke-app; на dev обычно ":0"
DISPLAY=:0
# FORCE_SMARTCARD_ENGINE — опционально, для karaoke-app
# ANN_TG_PROXY / ANN_TG_TOKEN — для announce.sh в Telegram-нотификациях
# Оставлены пустыми — опционально, не блокирует работу.
ANN_TG_PROXY=
ANN_TG_TOKEN=
