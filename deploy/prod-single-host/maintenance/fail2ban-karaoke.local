# fail2ban на прод-хосте: гасим SSH-перебор (задача KARAOKE-432).
#
# Замер 18.11.2026: 9 747 попыток входа за сутки, четыре источника по ~2 000
# каждая (77.239.124.144, 109.160.32.132, 77.239.124.156, 109.160.32.44),
# перебирали root, deployer, cloud, park, adminuser.
#
# Зачем: после отключения входа по паролю перебор теряет смысл, но до тех пор он
# реален, а журнал разрастается на десятки тысяч строк. fail2ban банит источник
# на час после серии неудач — шум падает, нагрузка уходит.
#
# ВАЖНО (наша специфика): публичный адрес админ-машины МЕНЯЕТСЯ (2026-11-09:
# 95.31.39.146 → 83.137.51.204). Если забанить собственный адрес, потеряем SSH.
# Поэтому:
#   * ignoreip включает loopback и подсеть туннеля 10.77.0.0/24;
#   * бан короткий (1 час), а не «навсегда»;
#   * вход по ключам продолжает работать даже при бане (бан по IP, не по ключу),
#     то есть самобан не отрезает нас от прод-хоста навсегда.
#
# Установка: /etc/fail2ban/jail.d/karaoke.local (права 644)
#   systemctl enable --now fail2ban && systemctl restart fail2ban

[DEFAULT]
# Ubuntu 26.04 пишет журнал в systemd-journal, отдельного /var/log/auth.log нет.
backend = systemd
# Час — достаточно, чтобы источник ушёл, и немного, чтобы не копить блокировки.
bantime = 1h
# Окно наблюдения: 5 неудач за 10 минут = перебор, а не опечатка.
findtime = 10m
maxretry = 5
# Чем банить: на хосте nftables 1.1.6 — используем родной backend.
banaction = nftables-multiport
banaction_allports = nftables-allports
# Себя не баним никогда: loopback и подсеть туннеля к проду.
ignoreip = 127.0.0.1/8 ::1 10.77.0.0/24

[sshd]
enabled = true
# aggressive: учитывает и попытки до аутентификации (Invalid user, preauth) —
# именно так выглядит наш перебор.
mode = aggressive
port = ssh
logpath = %(sshd_log)s
