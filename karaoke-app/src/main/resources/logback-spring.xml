<?xml version="1.0" encoding="UTF-8"?>
<!--
  Логирование karaoke-app: конвертер исключений без кадров стека.

  KARAOKE-387 (спека 732): в логах — нормальные сообщения, а не простыни
  `at com.svoemesto…`. Свойство `logging.pattern.console` (см. application.yml)
  заканчивается на `%causeChain` — это однострочная цепочка причин; полный стек
  печатается только при `LOG_STACKTRACES=true` (тот же флаг, что у AppLog).

  Подключается ИМЕННО `base.xml`, а не `console-appender.xml`: `base.xml` — это
  то, что Spring Boot и так подставляет, когда своего конфига нет (appendер
  CONSOLE + FILE, root level INFO). `console-appender.xml` даёт только appender
  без `<root>` с `appender-ref` — logback тогда пишет «Appender named [CONSOLE]
  not referenced» и «No appenders present in context [default]», то есть ВСЕ
  сообщения logback (включая ошибки приложения) пропадают из консоли. Регресс
  пойман на проде 2026-11-08 и закрыт тестом
  `CauseChainConverterTest.корневой логгер имеет appender CONSOLE`.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <conversionRule
            conversionWord="causeChain"
            class="com.svoemesto.karaokeapp.logging.CauseChainConverter"/>
</configuration>
