# Шаблон конфигурации WireGuard-пира «prod» (сторона прод-хоста 188.127.240.124).
#
# Спека 733 (FR-001, FR-010). Файл устанавливается на прод-хосте ВЛАДЕЛЬЦЕМ
# (или агентом — только по отдельному согласию), в `/etc/wireguard/wg0.conf`
# с правами 600. Поднимается стандартным `wg-quick up wg0`.
#
# Приватный ключ прод-пира генерируется НА ПРОДЕ и в репозиторий не попадает:
# в шаблоне — только placeholder.

[Interface]
# Постоянный внутренний адрес прод-стороны туннеля. Это тот самый адрес,
# по которому и приложение, и оператор с хоста (DBeaver) ходят на прод-каналы
# (FR-031, FR-032).
Address = 10.77.0.2/24
# UDP-порт, на котором прод слушает рукопожатия. Он остаётся открытым наружу:
# аутентификация пира — криптографическая (WireGuard), а не по IP (FR-011).
ListenPort = 51820
# PrivateKey = <ГЕНЕРИРУЕТСЯ НА ПРОДЕ, НЕ В РЕПОЗИТОРИИ>

[Peer]
# Публичный ключ пира «admin» (передаётся владельцем при установке).
PublicKey = <PUBLIC_KEY_OF_ADMIN_PEER>
# Какие источники принимаются от пира «admin». В списке — ровно один
# постоянный внутренний адрес (FR-005): 10.77.0.1. Трафик с адресов docker-сети
# или LAN-админки сюда не попадает — контейнер делает SNAT в 10.77.0.1.
AllowedIPs = 10.77.0.1/32
# Прод-сторона не инициирует соединение (её адрес постоянный, рукопожатие
# всегда приходит от админской машины) — keepalive не нужен.
