# Проверка живости контейнеров раз в минуту (инцидент 2026-11-18).
# Задержка в минуту — компромисс: обнаружение зомби за минуту вместо часов,
# при этом стоимость прогона — один `docker inspect` на контейнер.

[Unit]
Description=Проверка живости контейнеров раз в минуту

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
