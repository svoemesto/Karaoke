## Секреты для скриптов деплоя. Копировать в do.env на хосте (НЕ в git).
## Взять реальные значения со старого прода (/root/Karaoke/deploy/do.env)
## или из ~/Karaoke/deploy/do.env на admin-машине.

## --- Наш registry (спек 540 / issue #286) ---
## REGISTRY_HOST — хост:порт ДЛЯ ЛОГИНА (без пути). Обязан содержать точку и порт,
## иначе docker не распознает первый компонент имени как registry.
REGISTRY_HOST=sm-karaoke.ru:5443
REGISTRY_USER=karaoke
REGISTRY_PASSWORD=CHANGE_ME
## DOCKER_REGISTRY — ПРЕФИКС ИМЁН образов проекта (хост/namespace).
## Было: svoemestodev — это namespace Docker Hub, не хост; отсюда дефект №1 карты #274.
DOCKER_REGISTRY=sm-karaoke.ru:5443/karaoke

## --- Окно dual-push (FR-015, решение #280) ---
## DUAL_PUSH=1 — публикуем и в наш registry, и в Docker Hub (архив отката);
## DUAL_PUSH=0 — только в наш registry. Переключение — вручную, владельцем,
## после двух успешных прод-деплоев или по истечении месяца.
DUAL_PUSH=1
DOCKER_HUB_USER=svoemestodev
## DOCKER_HUB_PASSWORD — PAT Docker Hub. Совместимость: если не задан,
## используется старое имя переменной DOCKER_PASSWORD.
DOCKER_HUB_PASSWORD=CHANGE_ME
## Устаревшее имя (оставлено для совместимости с существующими do.env):
DOCKER_PASSWORD=CHANGE_ME

## --- Harbor (инфра-сервер dub2000) ---
## HARBOR_PUSH=1 — dual push: образ публикуется и в текущий registry (его тянет прод),
##   и в Harbor (primary-каталог, UI, retention, робот-аккаунты).
## HARBOR_PUSH=0 — только текущий registry (поведение до перехода, дефолт).
## Если Harbor недоступен — WARN, деплой не блокируется.
HARBOR_PUSH=0
HARBOR_HOST=registry.sm-karaoke.ru
## Робот-аккаунт проекта (push/pull только в свой проект):
##   robot$svoemesto+svoemesto-ci
## ВАЖНО: имя содержит '$' — в do.env заключайте значение в ОДИНАРНЫЕ кавычки,
## иначе bash подставит пустую переменную $svoemesto и логин упадёт.
HARBOR_USER='robot$svoemesto+svoemesto-ci'
HARBOR_PASSWORD=CHANGE_ME
## Проект Harbor, куда кладутся образы проекта.
HARBOR_NAMESPACE=svoemesto

YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME
STEMJOBS_INTERNAL_SECRET=CHANGE_ME
# Каталог приватных результатов премиум-задания внутри контейнера karaoke-web.
# Должен быть на постоянном томе (${WEB_FOLDER_HOST} монтируется в контейнер).
STEMJOBS_RESULT_DIR=/home/Karaoke/webpictires/stemjobs-results
# Секрет заголовка X-Internal-Secret для POST /changerecords (двух-БД синхронизация).
# Одинаковое значение задаётся на боевом хосте (как SYNC_INTERNAL_SECRET для karaoke-web)
# и на админской машине (свойство syncInternalSecret в Karaoke.properties).
SYNC_INTERNAL_SECRET=CHANGE_ME
# Серверный (секретный) ключ проверки капчи Yandex SmartCaptcha (спека 564, OpenProject #362).
# До спеки 564 ключ лежал в публично изменяемой таблице tbl_public_settings (аудит BR-019) —
# теперь только здесь. Порядок выдачи: сначала инвентаризация таблицы (quickstart спеки 564),
# затем ротация ключа, затем значение — в этот файл на боевом хосте (НЕ в git).
CAPTCHA_SERVER_KEY=CHANGE_ME
VK_CLIENT_SECRET=CHANGE_ME
VK_APP_ID=CHANGE_ME
VK_REDIRECT_URI=https://sm-karaoke.ru/api/public/utils/vkOAuthCallback
VK_ID_CLIENT_ID=CHANGE_ME
VK_ID_CLIENT_SECRET=CHANGE_ME
VK_ID_REDIRECT_URI=https://sm-karaoke.ru/api/public/utils/vkIdOAuthCallback
# admin-машина (не новый хост), без изменений:
VK_ID_ADMIN_API_URL=http://nsa-i9:8898
