```
# Compiled and build artifacts
*.class
*.o
*.obj
*.out
build/
/.build/
target/
dist/

# Sensitive data
deploy/ollama_data/
deploy/whisper_models/

# Dependencies
.gradle/
node_modules/
venv/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*
/deploy/.env
/deploy/do.env
/deploy/web-server-deploy/deploy/.env
/deploy/web-server-deploy/deploy/do.env
/deploy/new_comp/sm-karaoke-system/deploy/.env
/deploy/new_comp/sm-karaoke-system/deploy/do.env

# Secrets — SSL-сертификаты и приватные ключи (Constitution Principle VIII.2)
*.key
*.pem
*.p12
*.pfx

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Generated API documentation (run ./tools/generate-docs.sh to rebuild)
docs/api/dokka/
docs/api/typedoc-*/

# Local tool indexes / config (per-machine, not part of repo)
.codegraph/
.opencode/
.dsh/

# Cache files generated by `specify` CLI for the integration catalog
# (re-created on every `specify integration ...` invocation).
.specify/integrations/.cache/

# Per-machine speckit session state (specs/102-gitignore-feature-json) — указывает, какая фича
# сейчас активна НА ЭТОЙ машине/агенте; при параллельной работе нескольких машин/агентов над
# разными фичами коммит этого файла даёт merge-конфликт при каждом слиянии веток (см. PR #133/#134).
.specify/feature.json
```