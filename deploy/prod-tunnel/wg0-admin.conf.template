# Шаблон конфигурации WireGuard-пира «admin» (сторона админской машины).
#
# Спека 733 (FR-001, FR-030). ВНИМАНИЕ: это ШАБЛОН — приватный ключ сюда
# НЕ вписывается и файл не коммитится. Реальный конфиг создаётся на хосте
# скриптом `install-admin-tunnel.sh` (ключ генерируется на месте, права 600).
#
# Как это работает в контейнере `karaoke-app`:
#   интерфейс `wg0` поднимает САМО приложение (FR-027) — командами `ip`/`wg`
#   в своём сетевом пространстве; ключ приложению не читает, его получает `wg`
#   по пути файла (PRIVACY: содержимое ключа не попадает ни в лог, ни в argv).
#   Поэтому контейнеру нужны `NET_ADMIN` и `/dev/net/tun`
#   (см. `deploy/docker-compose-app.yml`).
#
# Этот файл — reference для администратора: те же значения, что использует
# приложение (адресация, endpoint, allowed-ips, keepalive).

[Interface]
# Постоянный внутренний адрес админской стороны туннеля. Именно этот адрес
# прод-хост видит как адрес источника — в его allow-list ровно одна строка
# `allow 10.77.0.1;` (FR-005).
Address = 10.77.0.1/24
# PrivateKey = <ГЕНЕРИРУЕТСЯ НА ХОСТЕ, НЕ В РЕПОЗИТОРИИ>
# ListenPort на админской стороне не нужен: инициатором всегда выступает
# админская машина (её публичный адрес плавает, у прода — постоянный).

[Peer]
# Публичный ключ пира «prod» (устанавливается на прод-хосте).
PublicKey = <PUBLIC_KEY_OF_PROD_PEER>
# Адрес пира «prod» — постоянный внутренний адрес прод-каналов (БД, MinIO,
# HTTPS). Его же использует оператор с хоста (DBeaver) — FR-031/FR-032.
AllowedIPs = 10.77.0.2/32
# Кто инициирует соединение: у прод-хоста постоянный публичный адрес.
Endpoint = 188.127.240.124:51820
# NAT-маппинг на стороне провайдера: без keepalive он протухает, и после смены
# внешнего адреса рукопожатие не проходит (смена IP не должна требовать правок
# на проде — FR-006).
PersistentKeepalive = 25
