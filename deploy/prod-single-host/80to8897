server {
  listen 443 ssl;
  server_name sm-karaoke.ru www.sm-karaoke.ru;
  ssl_certificate /etc/keys/www.sm-karaoke.ru.crt;
  ssl_certificate_key /etc/keys/www.sm-karaoke.ru.key;

  # ---------------------------------------------------------------------------
  # Заголовки безопасности (BR-558, аудит #336, порция P-72-06).
  #
  # Почему на уровне server{}, а не http{} в nginx.conf: http{} — общий файл
  # хоста, а site-конфиг 80to8897 — единственный, который описывает публичный
  # сайт sm-karaoke.ru; правило живёт рядом с теми location'ами, которых
  # касается (см. ниже про наследование add_header).
  #
  # ВАЖНО — наследование add_header в nginx: директивы наследуются с
  # предыдущего уровня (http{} → server{} → location{}) ТОЛЬКО если в самом
  # блоке НЕТ ни одной своей add_header. Поэтому любой location со своими
  # add_header (у нас это /minio/ и @minio_404) теряет серверные заголовки
  # целиком — там они объявлены явно, заново.
  #
  # always — заголовки должны приходить и на ошибочные ответы (4xx/5xx),
  # иначе при 404/502 они теряются и защита обходится тривиально.
  #
  # X-Frame-Options SAMEORIGIN — защита от clickjacking: сайт с регистрацией
  # и оплатой (ЮKassa) нельзя встроить в iframe чужого домена. SAMEORIGIN
  # (а не DENY) — плеер сайта встраивает сам себя в iframe (/player/:id) —
  # это same-origin, см. karaoke-public/src/views/PlaylistEditView.vue.
  #
  # X-Content-Type-Options nosniff — браузер не будет угадывать тип ответа.
  # НЕ применяем к /minio/ (см. ниже): объекты MinIO кладутся без
  # Content-Type (PutObjectArgs без contentType) → отдаются как
  # application/octet-stream, и nosniff может заблокировать показ картинок
  # автора/обложек в браузере.
  #
  # Referrer-Policy strict-origin-when-cross-origin — наружу уходит только
  # origin (не путь с идентификаторами песен/альбомов), внутри origin — полный
  # URL. Для публичных share-ссылок это убирает утечку идентификаторов.
  #
  # Strict-Transport-Security max-age=31536000 — браузер больше не ходит на
  # sm-karaoke.ru по http:// (первый запрос не может быть перехвачен/редиректнут).
  # includeSubDomains НЕ добавляем: поддомены домена не проверялись (правило
  # владельца — includeSubDomains только после проверки, что все поддомены
  # работают по HTTPS). www.sm-karaoke.ru обслуживается этим же server-блоком
  # и получает HSTS отдельно (HSTS действует на хост, а не на путь).
  # Порт 5443 (private registry) — тоже только TLS, HSTS его не ломает.
  # ---------------------------------------------------------------------------
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location /minio/ {
    # MinIO теперь локальный контейнер на этом же хосте (переезд #165):
    # 127.0.0.1:8890 → karaoke-storage:9000. MTU black-hole больше нет,
    # но path-proxy оставлен — ноль изменений в Java-коде (STORAGE_PROXY_URL).
    proxy_pass http://127.0.0.1:8890/;
    proxy_set_header Host $http_host;
    proxy_buffering off;
    proxy_read_timeout 60;
    proxy_send_timeout 60;
    # US4 (FR-003/004/005): HTTP-кеш для превью/картинок автора/альбома.
    # 24-часовой expires + ETag/Last-Modified для успешных ответов (FR-003/004).
    # 404-кэшируется на 5 минут (FR-005) — чтобы частые запросы несуществующих картинок
    # (например, анонимные /zakroma без превью) не возвращали 404 из MinIO каждый раз.
    expires 24h;
    # У этого location есть свои add_header → серверные заголовки безопасности
    # НЕ наследуются (правило nginx). Поэтому объявляем нужные здесь явно.
    # nosniff исключён осознанно: объекты MinIO хранятся без Content-Type
    # (PutObjectArgs без contentType в karaoke-app/services/StorageApiClient.kt)
    # → отдаются как application/octet-stream; с nosniff браузер может отказаться
    # показывать картинку автора/обложку альбома (public site грузит их как
    # /minio/karaoke/<файл>). X-Frame-Options/Referrer-Policy для бинарных
    # файлов безопасны и оставлены.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # security-headers-exempt: X-Content-Type-Options (объекты MinIO хранятся без
    # Content-Type → отдаются как application/octet-stream; nosniff может заблокировать
    # показ картинки автора/обложки альбома в браузере)
    add_header Cache-Control "public, max-age=86400";
    add_header ETag $upstream_http_etag;
    add_header Last-Modified $upstream_http_last_modified;
    error_page 404 = @minio_404;
  }
  # Real-time NDJSON chunked-stream для Закромов (specs/181-zakroma-author-load-progress).
  # Без proxy_buffering/gzip/proxy_cache OFF фронт получит весь ответ одним блоком после полной
  # отдачи backend — никакого «real-time» не будет. Этот location ОБЯЗАН стоять ДО общего /api/
  # (точнее, nginx выберет его по longest-prefix match: `/api/public/zakroma/stream` длиннее
  # `/api/`, поэтому порядок не критичен, но для читаемости держим рядом).
  # @minio_404 — короткий (5 мин) TTL для 404-ответов MinIO (FR-005): превью автора без картинки
  # не должно долбить MinIO каждым запросом от анонимных /zakroma-вкладок.
  location @minio_404 {
    # Как и у /minio/ выше: свои add_header отключают наследование серверных
    # заголовков → нужные объявляем явно. nosniff исключён по той же причине
    # (ответ MinIO-контура отдаётся как application/octet-stream).
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # security-headers-exempt: X-Content-Type-Options (объекты MinIO хранятся без
    # Content-Type → отдаются как application/octet-stream; nosniff может заблокировать
    # показ картинки автора/обложки альбома в браузере)
    add_header Cache-Control "public, max-age=300";
    return 404;
  }
  location /api/public/zakroma/stream {
    proxy_buffering off;
    gzip off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Host $host;
    proxy_set_header X-Nginx-Proxy true;
    proxy_connect_timeout 5s;
    proxy_next_upstream off;
    proxy_send_timeout 300s;
    proxy_pass http://127.0.0.1:8897;
  }
  location /api/ {
    proxy_pass http://127.0.0.1:8897/api/;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Host $host;
    proxy_set_header X-Nginx-Proxy true;
    client_max_body_size 200m;
    # Fail-fast при падении upstream (Pass 46, 2026-08-10): nginx-дефолты
    # `proxy_connect_timeout 60s` и `proxy_next_upstream error timeout` приводят к
    # 60-секундному зависанию страницы, когда karaoke-web (Spring Boot) падает
    # или рестартуется (Connection refused 111 / reset 104). Коннект отдаём
    # fail-fast 5s, дальше браузер сам увидит 502 и переподключится; SSE/long-poll
    # исключения (proxy_read/send_timeout 300s) сохраняем для текущих открытых коннектов.
    proxy_connect_timeout 5s;
    proxy_next_upstream off;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
  }
  # Сетевой рубеж для записи в публичные настройки (спека 564, OpenProject #359, аудит BR-019):
  # POST /api/properties/setproperty пишет в tbl_public_settings — таблицу, в которой лежали
  # kill-switch авто-публикации и (до спеки 564) серверный ключ капчи. Запись принимается
  # ТОЛЬКО с адреса админской машины — тот же список, что уже работает для внутренних портов
  # 5433 (прод-БД) и 9000 (MinIO) в nginx.conf и для location /changerecords ниже.
  # Адрес плавает у провайдера: 185.26.28.109 → 83.137.50.231 (2026-09-30) → 185.26.28.199
  # (2026-10-02); все три оставлены по слову владельца (2026-10-07), чтобы при смене адреса
  # доступ не терялся. Второй рубеж — заголовок X-Internal-Secret (проверка в karaoke-web).
  # nginx выбирает location по НАИБОЛЬШЕМУ совпадению префикса, поэтому этот location
  # перекрывает общий /api/ — фильтр действует только на путь записи, а чтение
  # (/api/properties/getproperty, /api/properties/digest) остаётся доступным и ограничено
  # белым списком публичных ключей на стороне приложения.
  # ВНИМАНИЕ: до добавления нового адреса админской машины операция с него не пройдёт —
  # это ожидаемое поведение, а не регрессия.
  location /api/properties/setproperty {
    allow 185.26.28.109;
    allow 83.137.50.231;
    allow 185.26.28.199;
    deny all;
    proxy_pass http://127.0.0.1:8897/api/properties/setproperty;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Host $host;
    proxy_set_header X-Nginx-Proxy true;
    client_max_body_size 200m;
    proxy_connect_timeout 5s;
    proxy_next_upstream off;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
  }
  location /changerecords {
    # Сетевой рубеж для эндпоинта двух-БД синхронизации (спека 554, OpenProject #357):
    # запросы принимаются ТОЛЬКО с адреса админской машины — тот же список, что уже работает
    # для внутренних портов 5433 (прод-БД) и 9000 (MinIO) в nginx.conf. Адрес плавает у
    # провайдера: 185.26.28.109 → 83.137.50.231 (2026-09-30) → 185.26.28.199 (2026-10-02);
    # все три оставлены по слову владельца (2026-10-07), чтобы при смене адреса доступ не
    # терялся. Второй рубеж — заголовок X-Internal-Secret (проверка в karaoke-web).
    # ВНИМАНИЕ: до добавления нового адреса админской машины синхронизация с него не пройдёт —
    # это ожидаемое поведение, а не регрессия.
    allow 185.26.28.109;
    allow 83.137.50.231;
    allow 185.26.28.199;
    deny all;
    # SSE-стрим: те же fail-fast таймауты на подключение, что у /api/ (Pass 46, 2026-08-10),
    # чтобы при падении karaoke-web не держать клиента 60s в ожидании connect. Уже
    # открытый стрим не рвём (read/send 300s) — события SSE идут непрерывно.
    proxy_pass http://127.0.0.1:8897/changerecords;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Host $host;
    proxy_set_header X-Nginx-Proxy true;
    proxy_connect_timeout 5s;
    proxy_next_upstream off;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
  }
  # /song — раздвоение по User-Agent: боты VK/Telegram/etc → OG-endpoint
  # (картинка для сниппета в мессенджере); обычные браузеры → SPA karaoke-public
  # (Vue Router отрендерит SongView). Без этого фикса любой прямой URL
  # `https://sm-karaoke.ru/song?id=NNN` (из мессенджера, поста VK, или просто
  # правый клик «открыть в новой вкладке») показывал только картинку — критичный
  # баг шеринга (Pass 35, 2026-08-05, см. docs/architecture-notes.md).
  # Ответ upstream'а (SPA-nginx) уже содержит свои защитные заголовки (BR-549).
  # Без proxy_hide_header они приходят дважды — по одному от host-nginx и по одному
  # от SPA-nginx. Дубликат X-Frame-Options репортуют сканеры (значения одинаковые,
  # но заголовок должен быть один).
  location /song {
    if ($http_user_agent ~* "vkShare|TelegramBot|Twitterbot|facebookexternalhit|LinkedInBot|WhatsApp|Slackbot|ViberBot|SkypeUriPreview|Googlebot|bingbot|YandexBot|YandexImages") {
      rewrite ^/song(\?.*)?$ /api/public/og/song$1 last;
    }
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass http://127.0.0.1:7907;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Host $host;
    proxy_set_header X-Nginx-Proxy true;
  }
  location / {
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass http://127.0.0.1:7907/;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Host $host;
    proxy_set_header X-Nginx-Proxy true;
  }
}

server {
  listen 80;
  server_name sm-karaoke.ru www.sm-karaoke.ru minio-proxy;
  # Заголовки безопасности на HTTP-контуре (BR-558, аудит #336 P-72-06).
  # Набор тот же, что на 443 (см. комментарий в server { listen 443 ssl; } выше),
  # кроме Strict-Transport-Security: браузер игнорирует HSTS, полученный по
  # небезопасному каналу (RFC 6797 §7.2), а сам домен живёт по HTTPS — HSTS
  # присылает 443-блок. Остальные заголовки нужны и тут: /minio/ на 80 отдаёт
  # те же публичные файлы, а location / — 301-редирект на HTTPS.
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  location /minio/ {
    proxy_pass http://127.0.0.1:8890/;
    proxy_set_header Host $http_host;
    proxy_buffering off;
    proxy_read_timeout 60;
    # US4 (FR-003/004/005) — см. аналогичный блок в server { listen 443 ... } выше.
    expires 24h;
    # Свои add_header отключают наследование серверных заголовков → объявляем
    # нужные явно; nosniff исключён по причине из 443-блока (объекты MinIO
    # без Content-Type → application/octet-stream).
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # security-headers-exempt: X-Content-Type-Options (объекты MinIO хранятся без
    # Content-Type → отдаются как application/octet-stream; nosniff может заблокировать
    # показ картинки автора/обложки альбома в браузере)
    add_header Cache-Control "public, max-age=86400";
    add_header ETag $upstream_http_etag;
    add_header Last-Modified $upstream_http_last_modified;
    error_page 404 = @minio_404;
  }
  # Обход той же MTU-проблемы (docker bridge=1500 vs физический ens3=1450), что и у /minio/ выше,
  # но для внешнего HTTPS API (Yandex SmartCaptcha /validate) — TLS handshake из контейнера напрямую
  # виснет (SslHandshakeTimeoutException), а хостовый nginx использует ens3 напрямую и не подвержен багу.
  location /smartcaptcha/ {
    proxy_ssl_server_name on;
    proxy_pass https://smartcaptcha.yandexcloud.net/;
    proxy_set_header Host smartcaptcha.yandexcloud.net;
    proxy_read_timeout 15;
    proxy_send_timeout 15;
  }
  # Тот же обход MTU black-hole, что и /smartcaptcha/ выше, но для ЮKassa API (создание платежа,
  # проверка статуса на вебхуке — PaymentService в karaoke-web). YOOKASSA_API_URL=http://minio-proxy/yookassa.
  # Реальный API ЮKassa живёт под /v3/ (https://api.yookassa.ru/v3/payments) — без этого суффикса
  # запросы 404-или (PaymentService.createPayment падал на POST /yookassa/payments -> 404).
  # Authorization проксируется явно — Basic Auth <base64(shop_id:secret_key)>, без него ЮKassa
  # отвечает 401/400. По умолчанию nginx уже прокидывает клиентские заголовки, но явное объявление
  # страхует от изменений дефолта в новых версиях и делает намерение читаемым.
  # proxy_pass_request_headers on — дефолт, оставлено для явности (Pass 41, PR #211).
  location /yookassa/ {
    proxy_ssl_server_name on;
    proxy_pass https://api.yookassa.ru/v3/;
    proxy_set_header Host api.yookassa.ru;
    proxy_set_header Authorization $http_authorization;
    proxy_pass_request_headers on;
    proxy_read_timeout 15;
    proxy_send_timeout 15;
  }
  location / {
    return 301 https://sm-karaoke.ru$request_uri;
  }
}
